<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ will device-to-device transfer app data even when
    android:allowBackup is false, so the exclusions are spelled out explicitly.
    The WebView cookie jar holds a live Supabase session; copying it to another
    device would hand over a signed-in browser.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
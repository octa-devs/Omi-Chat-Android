<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background: the same diagonal brand-400 -> brand-800 gradient the
    legacy launcher PNGs are drawn with, expressed as a vector so it stays crisp
    at every launcher size instead of being resampled from a bitmap.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="@color/omi_brand_400" />
                <item android:offset="1.0" android:color="@color/omi_brand_800" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
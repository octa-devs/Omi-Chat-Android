# Supabase — the publishable key only.
#
# EXPO_PUBLIC_* variables are inlined into the JavaScript bundle at build
# time by the Expo CLI, so this file has to exist on whatever machine (or
# EAS build server) produces the binary. Safe to commit: the publishable key
# is designed to be public and Row Level Security is what protects the data.
#
# The SECRET key is never needed here. The app makes no server-side Supabase
# calls, and a secret key in a mobile bundle would be readable by anyone who
# unzips the APK.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Deep link scheme for Google OAuth. Must match the scheme in app.json.
EXPO_PUBLIC_OAUTH_SCHEME=omichat

# ==============================================================================
#  OMI CHAT - environment template
#
#  Copy to `.env` and fill in. `.env` holds PUBLISHABLE values only.
#  Anything secret belongs in `.env.local` (git-ignored, never bundled).
#
#  Project: Omi Chat
#  Backend: Supabase (Postgres + Row Level Security + Realtime + Storage)
#  Docs:    supabase.com/dashboard -> your project -> SQL Editor
# ==============================================================================


# ------------------------------------------------------------------------------
#  Supabase - publishable, safe for the browser
#
#  Project Settings -> API. The publishable key only works because Row Level
#  Security enforces access. The secret key bypasses RLS and must never appear
#  in a NEXT_PUBLIC_ variable or any file that gets bundled.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Only needed if you verify JWTs server-side. Not used by this app.
NEXT_PUBLIC_SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json


# ------------------------------------------------------------------------------
#  Supabase Auth redirects
#
#  These must appear under Authentication -> URL Configuration -> Redirect URLs,
#  or the OAuth callback is rejected. Add your production domain there too.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_AUTH_REDIRECT=http://localhost:3000/auth/callback
NEXT_PUBLIC_SUPABASE_SITE_URL=http://localhost:3000


# ------------------------------------------------------------------------------
#  Google OAuth
#
#  Configured in the Supabase dashboard (Authentication -> Providers -> Google)
#  and in Google Cloud Console (APIs & Services -> Credentials). No env var is
#  needed: Supabase holds the client secret and exchanges it server-side, so the
#  browser never receives it.
# ------------------------------------------------------------------------------


# ------------------------------------------------------------------------------
#  Public site metadata (Next.js metadata + the About page)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=hello@octadevs.fun


# ------------------------------------------------------------------------------
#  WebRTC ICE servers (comma separated)
#
#  STUN alone is enough for most home networks. Roughly 10-15% of carrier and
#  corporate NATs will fail to connect without a TURN relay, which needs
#  credentials from a provider such as Cloudflare or Twilio.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302


# ==============================================================================
#  Server-only - put these in `.env.local`, never in `.env`
# ==============================================================================

# Only required if you add a migration runner or any server code that must
# bypass RLS. This app is entirely client-side and its schema is applied by
# hand in the SQL Editor, so this can stay blank.
SUPABASE_SECRET_KEY=

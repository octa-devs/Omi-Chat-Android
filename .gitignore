# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js
/.next/
/out/
next-env.d.ts

# @opennextjs/cloudflare
# Adapter build output. Regenerated by `npm run deploy`, never committed.
/.open-next/
/.wrangler/
cloudflare-env.d.ts

# Wrangler's local secret store. `.dev.vars` holds no secrets and is committed,
# but `.dev.vars.*` and the production variant must not be.
.dev.vars.*
!.dev.vars

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
#
# `.env` is committed on purpose. It holds ONLY the Supabase publishable key,
# which is designed to be public - Row Level Security is what enforces access,
# not the key. The `.env*.local` rule below catches the secret key and any
# other server-only value.
.env*.local

# typescript
*.tsbuildinfo
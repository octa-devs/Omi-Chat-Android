# Copy to keystore.properties and fill in. The real file and any .jks are
# gitignored - never commit them.
#
#   cp keystore.properties.example keystore.properties
#
# Generate a key (validity 10000 days so it outlives any realistic horizon):
#
#   keytool -genkeypair -v -keystore omi-release.jks \
#           -keyalg RSA -keysize 4096 -validity 10000 -alias omi
#
# Then encode it for the CI secret OMI_KEYSTORE_BASE64:
#
#   base64 -w0 omi-release.jks > omi-release.jks.b64
#
# storeFile is resolved by the app module, so keep the .jks in the repo root
# next to this project and refer to it as ../omi-release.jks.

storeFile=../omi-release.jks
storePassword=
keyAlias=omi
keyPassword=
# ==============================================================================
#  OMI CHAT - environment
#
#  NEXT_PUBLIC_*  ->  inlined into the browser bundle. PUBLISHABLE VALUES ONLY.
#  Server-only    ->  .env.local  (git-ignored, never sent to the browser)
# ==============================================================================

# ------------------------------------------------------------------------------
#  Supabase (publishable, safe for the browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://lfbrsfenvhgwzaawuasw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_DHk7cmplT0dZY3fsCW4OdQ_3CCWSV0n
NEXT_PUBLIC_SUPABASE_JWKS_URL=https://lfbrsfenvhgwzaawuasw.supabase.co/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------------------------
#  Supabase redirects
#  These must also be listed under Authentication -> URL Configuration ->
#  Redirect URLs, or the OAuth callback is rejected.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_AUTH_REDIRECT=http://localhost:3000/auth/callback
NEXT_PUBLIC_SUPABASE_SITE_URL=https://omichatapp.octadevs.fun

# ------------------------------------------------------------------------------
#  Google OAuth
#
#  The client ID and secret live in TWO consoles, neither of them this file:
#    1. console.cloud.google.com  ->  APIs & Services  ->  Credentials
#    2. supabase.com/dashboard     ->  Authentication  ->  Providers  ->  Google
#
#  Supabase holds the secret server-side and exchanges it for a session, so the
#  browser never needs it. Never put a client secret in a NEXT_PUBLIC_ variable.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
#  Public site metadata (Next.js metadata + the About page)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://omichatapp.octadevs.fun
NEXT_PUBLIC_SUPPORT_EMAIL=hello@octadevs.fun

# ------------------------------------------------------------------------------
#  WebRTC ICE servers (comma separated)
#
#  STUN alone covers most home networks. Around 10-15% of carrier and corporate
#  NATs will fail to connect without a TURN relay, which needs credentials.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
